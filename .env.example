# AI-Native School ERP Configuration
APP_NAME="AI-Native School ERP Backend"
DEBUG=false

# Ollama LLM Connection
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_TEMPERATURE=0.1
OLLAMA_TIMEOUT_SECONDS=60.0

# Agent Execution Guardrails
AGENT_MAX_STEPS=8

# Database & Query Security
DATABASE_URL=sqlite+aiosqlite:///./school_erp.db
POSTGRES_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/school_erp
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20
DB_POOL_TIMEOUT=30.0

SQL_MAX_ROWS=100
SQL_TIMEOUT_SECONDS=5.0

# Educational Data Mining & ML Risk Thresholds
RISK_THRESHOLD_HIGH=0.70
RISK_THRESHOLD_MEDIUM=0.35
ANALYTICS_SCHEDULE_HOUR=2
ANALYTICS_SCHEDULE_MINUTE=0

# Document Ingestion & Local ChromaDB
CHROMADB_PERSIST_DIR=./chroma_knowledge_base
DOCUMENT_UPLOAD_DIR=./uploaded_documents
# TESSERACT_CMD="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"
